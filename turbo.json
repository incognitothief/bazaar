{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "APP_URL",
        "ATPROTO_OAUTH_REDIRECT_URI",
        "PUBLIC_WEB_APP_URL",
        "VITE_APP_URL",
        "VITE_API_ORIGIN"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
