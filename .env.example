# Quick reference only. The real templates are:
#   packages/server/.env.example   (server runtime)
#   packages/client/.env.example   (browser bundle, VITE_*)
#
# Deployed instances set server vars with `fly secrets set`, not this file.

# --- Local API process (packages/server) ---
PORT=3000
DATABASE_PATH=./data/app.db
STATIC_ROOT=../client/dist
APP_URL=http://localhost:3000

# --- Cloudflare R2 ---
# One credential set, used for BOTH inventory uploads and Litestream DB backups.
# All four required together, or the app starts with no backups and says so.
R2_BUCKET_NAME=
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- CI (GitHub Actions repository Variables, not read by Bun or Vite) ---
# DEPLOY_STG=true   Enables staging deploy on PRs. Must match 'true' exactly.
