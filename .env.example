# Server
PORT=3000
DATABASE_PATH=./data/app.db
STATIC_ROOT=../client/dist

# App URL — used to build the OAuth client_id and redirect URI.
# For local dev this can stay as-is (NodeOAuthClient uses "http://localhost" client_id).
# In production set this to your public HTTPS origin (e.g. https://bazaar.example.com).
APP_URL=http://localhost:3000

# ATProto OAuth
# In production, ATPROTO_OAUTH_REDIRECT_URI defaults to ${APP_URL}/api/atproto/callback.
# Override only if your callback lives at a different path.
# ATPROTO_OAUTH_REDIRECT_URI=https://bazaar.example.com/api/atproto/callback

# Cloudflare R2 (Litestream + optional app uploads)
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Pulumi (S3 backend on R2 — use R2 "Manage R2 API Tokens" S3 keys)
# PULUMI_BACKEND_URL=s3://bazaar-pulumi-state-prod?endpoint=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com&region=auto&s3ForcePathStyle=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
