# Root example: quick reference. Full server and client templates live in:
#   packages/server/.env.example
#   packages/client/.env.example

# --- Local API (packages/server) ---
PORT=3000
DATABASE_PATH=./data/app.db
STATIC_ROOT=../client/dist

# App URL — used to build the OAuth client_id and redirect URI.
# For local dev this can stay as-is (NodeOAuthClient uses "http://localhost" client_id).
# In production set this to your public HTTPS origin (e.g. https://bazaar.example.com).
APP_URL=http://localhost:3000

# ATProto OAuth
# In production, ATPROTO_OAUTH_REDIRECT_URI defaults to ${APP_URL}/api/atproto/callback.
# Override only if your callback lives at a different path.
# ATPROTO_OAUTH_REDIRECT_URI=https://bazaar.example.com/api/atproto/callback

# Cloudflare R2 — one credential set, used for BOTH inventory uploads and Litestream DB
# backups (packages/server/src/lib/r2/env.ts, litestream.yml, docker-entrypoint.sh).
# All four are required together; with any one unset the app cannot reach R2 at all and
# docker-entrypoint.sh starts with no backups, saying so on stdout.
R2_BUCKET_NAME=
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- CI / GitHub Actions (repository Variables; not read by Bun or Vite) ---
# Set under: Settings → Secrets and variables → Actions → Variables
# When true, pull_request workflows run staging deploy + staging preflight (see .github/workflows/deploy.yml).
# Must match exactly: workflows use vars.DEPLOY_STG == 'true'
# DEPLOY_STG=true
#
# GitHub Environments `production` and `staging`: attach the same deploy secret names to each
# (FLY_API_TOKEN, FLY_APP_NAME*, VITE_*) with per-environment values.
# Repository-level secrets still apply if an environment omits a name.
