# Local development — copy to packages/server/.env (gitignored).
# Deployed: set the same names with `fly secrets set KEY=value` on each app.
# Setup walkthrough: ../../README.md

# === Required ===

# Store owner's ATProto DID. Server-only (NOT injected from the Vite build), but must
# equal the client's VITE_MERCHANT_DID. /api/merchant/* returns nothing without it.
MERCHANT_DID=did:plc:PLACEHOLDER

# Public origin of this API, no trailing path. Drives the OAuth redirect_uri
# (${APP_URL}/api/atproto/callback) and client-metadata URL.
# Local: use 127.0.0.1 — ATProto disallows "localhost" in redirect_uris.
# For real OAuth locally, prefer a tunnel over editing this file:
#   make tunnel && make dev TUNNEL_URL=https://xxxx.trycloudflare.com
APP_URL=http://127.0.0.1:3000

# --- Storefront signing identity: `make storefront-key DOMAIN=store.example.com` ---
# Set all four in ONE command; a partial set signs receipts that never verify.
# Unset entirely = app still boots, serves a DID doc with no verificationMethod,
# and signs unverifiable receipts. One warning line at startup is the only signal.
STOREFRONT_DID=did:web:PLACEHOLDER
# PEM (PKCS#8 or SEC1). Multiline OK, or one line with \n escapes.
STOREFRONT_PRIVATE_KEY=PLACEHOLDER
# Fragment in the served DID document. Format: storefront-key-YYYY-MM-DD[-N]
# STOREFRONT_KID=storefront-key-2026-08-29
# Tripwire, not a source of truth: the server publishes what the private key derives
# to regardless. A mismatch fails loudly instead of silently publishing a DID document
# that breaks verification of every receipt the real key signed.
# STOREFRONT_PUBLIC_MULTIBASE=z...

# --- Cloudflare R2: inventory bytes AND Litestream backups (one credential set) ---
# S3 API token with Object Read & Write on the bucket — not an account API token.
# All four required together. Debug: GET /api/inventory/r2-status → headBucket "ok".
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Stripe ---
# Optional here if saved via /merchant/settings (persisted in SQLite).
# Env values take precedence and lock the dashboard field.
# Webhook endpoint: POST /api/stripe/webhook, event checkout.session.completed.
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER

# === Optional ===

# base64(JSON array) of non-current keys. Unset on a first deploy; maintained by
# `make storefront-key-rotate`. "revoked": true rejects that key's signatures outright.
# STOREFRONT_KEY_HISTORY=

# Where buyers load the SPA (Stripe success/cancel returns). Defaults to APP_URL.
# Split dev (Vite :5173 + API :3000): http://127.0.0.1:5173
# PUBLIC_WEB_APP_URL=
# PUBLIC_WEB_APP_URL_ALLOW_LOOPBACK_HTTPS=true   # only if you run HTTPS locally (mkcert)

# Origin for server-injected link meta (og:url, canonical). Defaults to APP_URL.
# Set when the storefront is served on a different hostname than this API.
# PUBLIC_WEB_ORIGIN=https://store.example.com
# PUBLIC_SITE_NAME=Bazaar
# PUBLIC_OG_DEFAULT_IMAGE=https://store.example.com/og-default.png
# PUBLIC_TWITTER_SITE=myhandle

# Business profile for /terms and /refunds. Each overrides the value from SQLite
# (editable in merchant Settings) when set.
# BUSINESS_NAME=
# BUSINESS_STATE=
# BUSINESS_EMAIL=

# PaymentIntent → PDS fulfillment retry interval (ms). 0 disables.
# BAZAAR_FULFILLMENT_SWEEP_MS=45000
# Extra OAuth scope tokens, space-separated, appended to the default (oauth-scope.ts).
# BAZAAR_OAUTH_SCOPE_EXTRA=
# Multipart upload threshold in bytes (default 8MiB).
# BAZAAR_INVENTORY_MULTIPART_MIN_BYTES=8388608
# Override only if your callback lives off the default path.
# ATPROTO_OAUTH_REDIRECT_URI=

# --- Local testing only ---
# Accept the preview listing at://dev.bazaar.invalid/... without a PDS record.
# BAZAAR_DEV_CHECKOUT_STUB=true
# If PutObject returns 501 / checksum errors on an older server build:
# AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
# AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED
