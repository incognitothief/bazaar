# ATProto / app service
ATPROTO_SERVICE=https://bsky.social
APP_DID=did:plc:PLACEHOLDER
APP_SERVICE_PRIVATE_KEY=PLACEHOLDER

# Stripe
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER

# URLs used by server redirects and Stripe callbacks (use prod URL in production)
# Vite dev: set APP_URL to the SPA origin (e.g. http://localhost:5173).
APP_URL=http://localhost:5173
# Public https:// base for OAuth client_id + jwks (must be reachable from the internet).
# Dev: run e.g. `cloudflared tunnel --url http://127.0.0.1:3000` and paste the trycloudflare URL here (no trailing slash).
BAZAAR_OAUTH_METADATA_ORIGIN=https://YOUR_TUNNEL.trycloudflare.com
# Where this API listens for the OAuth *callback* in your browser. Use 127.0.0.1 (not "localhost").
BAZAAR_API_ORIGIN=http://127.0.0.1:3000
# Optional override if the default `${BAZAAR_API_ORIGIN}/api/atproto/callback` is wrong:
# ATPROTO_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/atproto/callback
# Comma-separated browser origins allowed to call /api with credentials (Vite dev, production SPA host)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LEXICON_NAMESPACE=diamonds.whereditgo.bazaar
ARTIST_DID=did:plc:PLACEHOLDER

# ATProto OAuth (@atproto/oauth-client-node): ES256 private JWK JSON (one line).
# Generate: npm run oauth:jwk -w @bazaar/server
# ATPROTO_OAUTH_PRIVATE_KEY_JWK={"kty":"EC","kid":"bazaar-oauth",...}
#
# Discoverable client_id must be https with a non-loopback DNS name (@atproto/oauth-types). For
# local-only UI work without OAuth, use DEV_ATP_SESSION_JSON below.

# Non-production only: merchant session without OAuth (use real JWTs from your account).
# One line, no spaces around "=". Sets cookie on GET /api/atproto/session or visit:
# http://localhost:3000/api/atproto/dev-bootstrap
# DEV_ATP_SESSION_JSON={"did":"did:plc:...","handle":"you.bsky.social","accessJwt":"...","refreshJwt":"..."}
