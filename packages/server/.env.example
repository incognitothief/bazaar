# Local development — copy to packages/server/.env (gitignored).
#
# Deployment (hosted):
#   - Server-only secrets: set on each Fly app with `fly secrets set KEY=value` (production: fly.toml app;
#     staging: fly.stg.toml app). Use the same variable names as below.
#   - Client bundle (VITE_*): injected at Docker build time in CI; see packages/client/.env.example.
#   - PR → staging automation: GitHub repository variable DEPLOY_STG=true (not loaded by this process).
#     CI jobs use GitHub Environments `production` vs `staging` for duplicate secret names.

# ATProto / app service
ATPROTO_SERVICE=https://bsky.social
# DID of this Bazaar app on receipts/consent. For third-party verification via did:web, set this to the same
# `id` as packages/server/config/did-document.template.json (e.g. did:web:bazaar.whereditgo.diamonds) and serve /.well-known/did.json.
APP_DID=did:plc:PLACEHOLDER
# PEM for receipt/consent appSig and bazaarRid / bazaarWid / bazaarPid (see 26_4_3-identifier-signing-strategy-v1.md):
# PKCS#8 or SEC1 (BEGIN EC PRIVATE KEY); multiline OK; or one-line + \n escapes
# REQUIRED on the API process that runs inventory publish (not the Vite client). If missing you get
# identifiers_unconfigured (503). If present but invalid, or signing fails, you get identifier_sign_failed
# (500) with phase "rid" | "wid" | "pid" — check server logs for the underlying OpenSSL error.
APP_SERVICE_PRIVATE_KEY=PLACEHOLDER
# Injected into packages/server/config/did-document.template.json at server startup (same fragment in
# verificationMethod id and assertionMethod). Format: app-key-YYYY-MM-DD. When set, receipts/consent include lexicon `kid`.
# Generate: ./scripts/gen-did.sh (or npx tsx scripts/gen-did.ts <path-to-public.pem>).
# APP_SERVICE_KID=app-key-2026-04-17
# Optional: multibase public key (z…). If unset, derived from APP_SERVICE_PRIVATE_KEY when that PEM is valid.
# APP_SERVICE_PUBLIC_MULTIBASE=z...

# PaymentIntent → PDS fulfillment sweeper interval (ms). Set 0 to disable background retries.
# BAZAAR_FULFILLMENT_SWEEP_MS=45000

# Stripe — optional here if the store owner saves keys from /merchant/dashboard (persisted in SQLite).
# Environment values override dashboard-saved keys. Webhook verification needs whsec_… for POST /api/stripe/webhook.
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER

# When true, Checkout + webhook accept the storefront preview listing
# at://dev.bazaar.invalid/... without a PDS record (local Stripe testing only).
# BAZAAR_DEV_CHECKOUT_STUB=true

# Public origin of THIS API (no path). Drives OAuth redirect_uri = ${APP_URL}/api/atproto/callback,
# client-metadata URL, and post-OAuth redirects — NOT read from the client.
#
# Must match packages/client VITE_API_ORIGIN when you use real OAuth (mock sign-in off): same
# scheme, host, and port. If the client hits https://tunnel… but APP_URL stays http://127.0.0.1:3000,
# Bluesky / many PDSes reject redirect_uri or the flow breaks.
#
# Local: http://127.0.0.1:3000 (not "localhost"; ATProto disallows localhost in redirect_uris).
# If that still fails with invalid redirect_uri, use HTTPS (e.g. cloudflared) and set APP_URL to it.
APP_URL=http://127.0.0.1:3000

# Public origin for server-injected link meta (og:url, canonical, stable /api/.../artwork-open URLs).
# Defaults to APP_URL. Set when the storefront is served on a different hostname than this API
# (otherwise share previews may point at the API host only).
# PUBLIC_WEB_ORIGIN=https://your-store.example

# Product name for og:site_name in injected <head> (whitelabel).
# PUBLIC_SITE_NAME=Bazaar

# Default og:image when item artwork is missing (full URL). If unset, uses ${PUBLIC_WEB_ORIGIN or APP_URL}/og-default.png.
# PUBLIC_OG_DEFAULT_IMAGE=https://your-store.example/og-default.png

# Optional Twitter handle for twitter:site (with or without leading @).
# PUBLIC_TWITTER_SITE=myhandle

# Where buyers load the SPA. If you use Vite on :5173 and API on :3000, set this so
# Stripe success/cancel URLs return to the dev client (matches VITE_APP_URL).
# Use http:// (Vite dev is not HTTPS by default). https://127.0.0.1:5173 breaks the redirect.
# If you run HTTPS locally (e.g. mkcert), set PUBLIC_WEB_APP_URL_ALLOW_LOOPBACK_HTTPS=true.
# PUBLIC_WEB_APP_URL=http://127.0.0.1:5173
# Use that same host in the browser (127.0.0.1, not localhost) so cookies match Stripe’s success redirect.
LEXICON_NAMESPACE=diamonds.whereditgo.bazaar
# Store owner DID: must match packages/client VITE_ARTIST_DID (same person), but this is SERVER-ONLY.
# Required for /api/merchant/* (Stripe settings UI, payment activity). Not injected from the Vite build —
# set it in the API process env (e.g. fly secrets set ARTIST_DID=did:plc:…).
ARTIST_DID=did:plc:PLACEHOLDER

# Business profile (shown on /terms and /refunds). Editable in merchant Settings unless overridden here.
# Each variable, if set, overrides the matching field from SQLite for the public API and legal pages.
# BUSINESS_NAME=
# BUSINESS_STATE=
# BUSINESS_EMAIL=

# Cloudflare R2 (inventory bytes; bucket from packages/infra Pulumi `primary` / r2BucketName)
# Create keys under R2 → your bucket → Manage R2 API Tokens. The token must allow **Object Read & Write**
# (or Admin Read & Write) on **that bucket** — Account API tokens are not the same.
# CF_ACCOUNT_ID=   # Account ID from Cloudflare dashboard (not Zone ID)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME= # Exact bucket name
# Debug: GET /api/inventory/r2-status (merchant session cookie) → headBucket should be "ok"
#
# NOTE: this is a SEPARATE credential set from Litestream DB backups, even though both point at the
# same bucket. Litestream needs its own four vars — R2_BUCKET, R2_ENDPOINT, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY (repo-root .env.example, litestream.yml) — and docker-entrypoint.sh silently
# runs the app with NO backups if even one of those four is missing. Setting only CF_ACCOUNT_ID/
# R2_BUCKET_NAME above (this block) makes uploads work but does nothing for backups.
# If PutObject returns 501 / checksum errors with an older server build, the S3 client sets
# requestChecksumCalculation=WHEN_REQUIRED. You can also try:
# AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
# AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED
# Optional: multipart threshold in bytes (default 8MiB)
# BAZAAR_INVENTORY_MULTIPART_MIN_BYTES=8388608
# Multipart: the web client tries presigned PUT to R2 first (fastest when bucket CORS allows your app
# origin), then falls back to POST .../multipart/upload-part through this API if direct upload fails.
# The inventory client maps HTTP failures to readable messages; multipart/complete errors return JSON
# with `message` when the handler catches them (instead of empty proxy bodies).

# Default OAuth scope = atproto + transition:generic + Bazaar repo:* collections (see oauth-scope.ts).
# Optional: extra tokens (space-separated) appended after those.
# BAZAAR_OAUTH_SCOPE_EXTRA=

# ATProto OAuth (DPoP via @atproto/oauth-client-node)
# Loopback dev (APP_URL on 127.0.0.1): fine-grained scopes are embedded in client_id (?scope=...).
# If the authorize URL grows too large, use HTTPS APP_URL (e.g. cloudflared) + hosted client-metadata.json.
# Override only if you must; default is ${APP_URL}/api/atproto/callback (must still match APP_URL host).
# ATPROTO_OAUTH_REDIRECT_URI=
