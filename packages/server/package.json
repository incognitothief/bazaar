{
  "name": "@bazaar/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx --yes bun@1.4.0 run --watch src/index.ts",
    "build": "npx --yes bun@1.4.0 build src/index.ts --outdir=dist --target=bun",
    "start": "npx --yes bun@1.4.0 dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx --yes bun@1.4.0 run src/migrate.ts",
    "test": "npx --yes bun@1.4.0 test"
  },
  "dependencies": {
    "@atproto/api": "^0.19.5",
    "@atproto/common-web": "^0.4.19",
    "@atproto/identity": "^0.5.7",
    "@atproto/oauth-client": "^0.6.0",
    "@atproto/oauth-client-node": "^0.3.17",
    "@atproto/syntax": "^0.5.2",
    "@aws-sdk/client-s3": "^3.1024.0",
    "@aws-sdk/s3-request-presigner": "^3.1024.0",
    "@bazaar/shared": "*",
    "drizzle-orm": "^0.38.3",
    "fflate": "^0.8.2",
    "hono": "^4.6.14",
    "multiformats": "^13.4.2",
    "stripe": "^21.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^0.30.1",
    "typescript": "~5.7.2"
  }
}
