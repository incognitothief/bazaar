{
  "name": "@bazaar/shared",
  "private": true,
  "license": "AGPL-3.0-only AND Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./lexicons": {
      "types": "./src/lexicons/docs.ts",
      "import": "./src/lexicons/docs.ts",
      "default": "./src/lexicons/docs.ts"
    },
    "./license-templates": {
      "types": "./src/license-templates/registry.ts",
      "import": "./src/license-templates/registry.ts",
      "default": "./src/license-templates/registry.ts"
    }
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/lexicons dist/license-templates && cp src/lexicons/*.json dist/lexicons/ && cp src/license-templates/*.json dist/license-templates/",
    "validate-lexicons": "node ./scripts/validate-lexicons.mjs"
  },
  "dependencies": {
    "@atproto/lexicon": "^0.6.2"
  },
  "devDependencies": {
    "typescript": "~5.7.2"
  }
}
