{
  "lexicon": 1,
  "id": "diamonds.whereditgo.bazaar.catalog.item.bundle",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "title",
          "artistDid",
          "items",
          "createdAt"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 512
          },
          "artistDid": {
            "type": "string",
            "format": "did"
          },
          "description": {
            "type": "string",
            "maxLength": 4096
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "diamonds.whereditgo.bazaar.defs#itemRef"
            },
            "minLength": 2
          },
          "artworkCid": {
            "type": "string",
            "format": "cid"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
