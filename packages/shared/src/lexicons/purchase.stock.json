{
  "lexicon": 1,
  "id": "diamonds.whereditgo.bazaar.purchase.stock",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "itemUri",
          "itemCid",
          "variantSku",
          "quantityAvailable",
          "updatedAt"
        ],
        "properties": {
          "itemUri": {
            "type": "string",
            "format": "at-uri"
          },
          "itemCid": {
            "type": "string",
            "format": "cid"
          },
          "variantSku": {
            "type": "string",
            "maxLength": 128
          },
          "quantityAvailable": {
            "type": "integer",
            "minimum": 0
          },
          "quantityReserved": {
            "type": "integer",
            "minimum": 0
          },
          "quantitySold": {
            "type": "integer",
            "minimum": 0
          },
          "isUnlimited": {
            "type": "boolean",
            "description": "True for digital items or print-on-demand goods."
          },
          "lowStockThreshold": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
