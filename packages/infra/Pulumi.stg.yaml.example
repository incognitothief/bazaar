# Copy to Pulumi.stg.yaml (gitignored) after: pulumi stack init stg
# Creates the primary R2 bucket bazaar-stg only. The Pulumi state bucket is created by stack `prod`
# (default name bazaar-pulumi-state-prod); use the same PULUMI_BACKEND_URL in CI as prod.
config:
  bazaar-infra:cloudflareAccountId: YOUR_ACCOUNT_ID
  # If prod used a custom state bucket name (pulumiStateBucketName on prod), set it here too:
  # bazaar-infra:sharedPulumiStateBucketName: your-shared-state-bucket
  # Optional overrides:
  # bazaar-infra:bucketName: my-unique-stg-bucket
  # bazaar-infra:location: WNAM
