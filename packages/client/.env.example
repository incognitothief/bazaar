# Local development — copy to packages/client/.env (gitignored).
# Exposed to the browser as import.meta.env.VITE_*
# Deployed: CI passes these as Docker build-args (see .tangled/workflows/deploy-*.yml).
# Setup walkthrough: ../../README.md

# === Required ===

# The ATProto identity (catalog repo) this storefront sells on behalf of.
# Must equal the server's MERCHANT_DID. Also gates merchant console access:
# the signed-in DID must match this value.
VITE_MERCHANT_DID=did:plc:PLACEHOLDER

# === Optional ===

# Footer "Source Code" link. Unset points at upstream. If you run a modified Bazaar,
# set this to your fork so the link shows your version.
# VITE_SOURCE_URL=https://tangled.org/you/your-bazaar-fork
# Commit the build came from, so the link resolves to the running revision.
# Recognises tangled.org (full SHA only), github.com, gitlab.com and codeberg.org URL shapes.
#   VITE_SOURCE_COMMIT=$(git rev-parse HEAD)
# VITE_SOURCE_COMMIT=

# Whitelabel. Match the server's PUBLIC_* equivalents in production.
# VITE_PUBLIC_SITE_NAME=Bazaar
# VITE_PUBLIC_OG_DEFAULT_IMAGE=https://store.example.com/og-default.png
# VITE_PUBLIC_TWITTER_SITE=myhandle
# Fallback contact on /terms and /refunds when business email is unset.
# VITE_CONTACT_EMAIL=support@example.com

# --- Dev only ---
# Skip OAuth on merchant sign-in; session in localStorage. Resolved DID must
# still equal VITE_MERCHANT_DID.
# VITE_DEV_MOCK_ATPROTO_SIGNIN=true
# Force a specific item AT-URI for the dummy Storefront link when Listings is empty.
# VITE_DEV_DUMMY_ITEM_URI=at://did:plc:…/diamonds.whereditgo.bazaar.catalog.product/…
# Show the dummy row under `vite preview` / a production build.
# VITE_SHOW_LISTINGS_DUMMY=true

# NOTE: there is no API origin or storefront URL to configure. The API is always
# same-origin with the SPA (Vite proxies /api in dev; Bun serves the built client in
# production), and the canonical / og: tags crawlers read are injected server-side from
# the server's PUBLIC_WEB_ORIGIN. See docs/adr/0022.
#
# NOTE: there is no ATProto host to configure. Every repo read resolves the DID's own
# PDS via /api/atproto/resolve-pds, and a failed resolution throws rather than falling
# back to a default host. See docs/adr/0021.
