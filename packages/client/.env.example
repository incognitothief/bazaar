# Local development — copy to packages/client/.env (gitignored).
# Exposed to the browser via import.meta.env.VITE_*
#
# Hosted builds: CI passes these as Docker build-args (production and staging workflows). Prefer GitHub
# Environment secrets (`production` / `staging`) with the same names, different values per app URL.
# PR → staging deploys require repository variable DEPLOY_STG=true (see repo root .env.example).
#
# Fixed fallback service — required (createPublicAgent() has no fallback of its own).
# For DID-scoped reads, the server's /api/atproto/resolve-pds is now the primary path
# (DID→PDS/handle, and handle→DID with bidirectional verification — see
# packages/server/src/lib/atproto/resolvePds.ts); this var is only the last resort when
# that resolution fails, and is no longer used for mock sign-in (handle resolution there
# goes through the same resolver, no AppView dependency). Some call sites
# (createPublicAgent() directly — HomePage, ItemDetailPage, PurchaseDetailPage,
# SettingsPage, PublicHeaderAccount, useActorMerchantProfile) still use this host
# unconditionally rather than resolving per-DID; migrating those is a separate,
# not-yet-done pass, so don't leave this unset.
VITE_ATPROTO_SERVICE=https://bsky.social
# Storefront DID that signs receipts/consent — did:web only, matching the server STOREFRONT_DID
# and the served /.well-known/did.json `id`.
VITE_STOREFRONT_DID=did:web:bazaar.whereditgo.diamonds
# Browser URL for the SPA; should match server PUBLIC_WEB_APP_URL (see packages/server/.env.example)
# so Stripe redirects back to Vite in dev. Use 127.0.0.1 for OAuth parity.
VITE_APP_URL=http://127.0.0.1:5173
VITE_LEXICON_NAMESPACE=diamonds.whereditgo.bazaar
# Merchant DID: the ATProto identity (catalog repo / actor.merchant) this storefront sells on behalf of.
VITE_MERCHANT_DID=did:plc:PLACEHOLDER
# Origin the browser uses for API calls and for "Sign in" navigation (/api/atproto/signin).
# In Vite dev, leave unset to use same-origin /api proxy, or set e.g. http://127.0.0.1:3000.
#
# Real OAuth (VITE_DEV_MOCK_ATPROTO_SIGNIN unset or false): the authorization server gets
# redirect_uri from the SERVER env APP_URL as ${APP_URL}/api/atproto/callback — not from this file.
# VITE_API_ORIGIN and APP_URL must therefore be the SAME public origin (scheme + host + port).
# Example with cloudflared: set both to https://your-subdomain.trycloudflare.com
# Prefer injecting for one run instead of rewriting this file:
#   make dev CLOUDFLARED_URL=https://xxxx.trycloudflare.com
# That overrides VITE_APP_URL and VITE_API_ORIGIN (and the matching server URL vars).
# If you only change VITE_API_ORIGIN but leave APP_URL on http://127.0.0.1:3000, sign-in can fail
# with invalid_request / invalid redirect_uri (many PDS hosts reject plain http://127.0.0.1:…).
VITE_API_ORIGIN=http://127.0.0.1:3000

# Public product name for <title> / Helmet meta (whitelabel; default Bazaar). Match server PUBLIC_SITE_NAME in production.
# VITE_PUBLIC_SITE_NAME=Bazaar

# Absolute URL for default og:image in Helmet when item art is unavailable (optional).
# VITE_PUBLIC_OG_DEFAULT_IMAGE=https://your-store.example/og-default.png

# Optional Twitter handle for twitter:site in Helmet (no @ required).
# VITE_PUBLIC_TWITTER_SITE=myhandle

# Fallback contact on /terms and /refunds when business email is unset (see Settings or BUSINESS_EMAIL).
# VITE_CONTACT_EMAIL=support@yourdomain.com

# Dev only: skip OAuth on merchant sign-in; session lives in localStorage (bazaar_mock_atp_session).
# Mock sign-in resolves the handle to a DID via the server's /api/atproto/resolve-pds
# (protocol-level DNS/well-known lookup, bidirectionally verified) — not VITE_ATPROTO_SERVICE.
# Merchant access: resolved DID must equal VITE_MERCHANT_DID (same rule as real OAuth).
# VITE_DEV_MOCK_ATPROTO_SIGNIN=true

# When Listings is empty: sample row uses your signed-in merchant DID + placeholder rkey.
# Optional: force a specific item AT-URI for the dummy Storefront link.
# VITE_DEV_DUMMY_ITEM_URI=at://did:plc:…/diamonds.whereditgo.bazaar.catalog.item.digital/…
#
# If you use `vite preview` or prod build but still want the dummy row:
# VITE_SHOW_LISTINGS_DUMMY=true
